<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Neo Analytics - Daily table</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <main class="container">
    <header class="hero" data-animate style="--delay: 0s;">
      <div>
        <h1>Neo Analytics</h1>
        <p class="subtitle">Daily activity table</p>
        <p class="hero-meta">Range: {{rangeLabel}}. Browse daily stats and drill into a specific day.</p>
      </div>
      <div class="hero-actions">
        <form class="range-form" method="get">
          <label>
            From
            <input type="date" name="from" value="{{rangeFrom}}" />
          </label>
          <label>
            To
            <input type="date" name="to" value="{{rangeTo}}" />
          </label>
          <button class="button" type="submit">Apply</button>
        </form>
        <div class="hero-links">
          <a class="button secondary" href="/?from={{rangeFrom}}&to={{rangeTo}}">Back to dashboard</a>
          <span class="pill">{{rangeLabel}}</span>
        </div>
      </div>
    </header>

    <section class="table" data-animate style="--delay: 0.1s;">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Total txs</th>
            <th>Swaps</th>
            <th>Transfers</th>
            <th>Gas claims</th>
            <th>Total tx excluding Gas Claims</th>
          </tr>
        </thead>
        <tbody>
          {{#each stats}}
          <tr>
            <td><a href="/day/{{this.dateLabel}}">{{this.dateLabel}}</a></td>
            <td>{{this.totalTxCountLabel}}</td>
            <td>{{this.swapsCountLabel}}</td>
            <td>{{this.transfersCountLabel}}</td>
            <td>{{this.gasClaimsCountLabel}}</td>
            <td>{{this.realUsageTotalLabel}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </section>
  </main>
</body>
</html>
