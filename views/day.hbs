<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Neo Analytics - {{date}}</title>
    <script>
      (function() { const savedTheme = localStorage.getItem('neo-theme'); if
      (savedTheme === 'dark' || (!savedTheme &&
      window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.setAttribute('data-theme', 'dark'); } })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main class="container">
      <header class="hero" data-animate style="--delay: 0s;">
        <div>
          <h1>Neo Analytics</h1>
          <p class="subtitle">Day details: {{date}}</p>
          <p class="hero-meta">Classified transactions and breakdowns for the
            selected day.</p>
        </div>
        <div class="hero-actions">
          <div class="hero-links">
            <a href="/" class="button">Back to dashboard</a>
            <button
              class="theme-toggle"
              id="theme-toggle"
              type="button"
              aria-label="Toggle dark mode"
              title="Toggle dark mode"
            >
              <svg
                class="sun-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 00-1.061 1.06l1.59 1.591z"
                />
              </svg>
              <svg
                class="moon-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>
          </div>
        </div>
      </header>

      {{#if stat}}
        <section class="summary-grid">
          <div class="card accent" data-animate style="--delay: 0.05s;">
            <span>Real usage total</span>
            <strong>{{stat.realUsageTotal}}</strong>
            <small>Swaps + transfers</small>
          </div>
          <div class="card" data-animate style="--delay: 0.1s;">
            <span>Total transactions</span>
            <strong>{{stat.totalTxCount}}</strong>
            <small>All scanned blocks</small>
          </div>
          <div class="card" data-animate style="--delay: 0.15s;">
            <span>Active addresses</span>
            <strong>{{stat.uniqueAddresses}}</strong>
            <small>Unique senders + receivers</small>
          </div>
          <div class="card" data-animate style="--delay: 0.2s;">
            <span>NEO volume</span>
            <strong>{{stat.neoVolume}}</strong>
            <small>Raw units</small>
          </div>
          <div class="card" data-animate style="--delay: 0.25s;">
            <span>GAS volume</span>
            <strong>{{stat.gasVolume}}</strong>
            <small>Raw units</small>
          </div>
          <div class="card" data-animate style="--delay: 0.3s;">
            <span>Blocks scanned</span>
            <strong>{{stat.blockCount}}</strong>
            <small>Daily total</small>
          </div>
        </section>
      {{else}}
        <p>No stats found for this day.</p>
      {{/if}}

      <section class="list-grid">
        <div class="list-card" data-animate style="--delay: 0.35s;">
          <h3>Asset breakdown</h3>
          <ul>
            {{#each assetStats}}
              <li>
                <div>
                  <div class="mono">{{this.asset}}</div>
                  <small>{{this.transferCount}} transfers</small>
                </div>
                <strong>{{this.volumeLabel}}</strong>
              </li>
            {{/each}}
          </ul>
        </div>
        <div class="list-card" data-animate style="--delay: 0.4s;">
          <h3>Top methods</h3>
          <ul>
            {{#each methodStats}}
              <li>
                <div class="mono">{{this.method}}</div>
                <strong>{{this.txCount}}</strong>
              </li>
            {{/each}}
          </ul>
        </div>
        <div class="list-card" data-animate style="--delay: 0.45s;">
          <h3>Top contracts</h3>
          <ul>
            {{#each contractStats}}
              <li>
                <div class="mono">{{this.contract}}</div>
                <strong>{{this.txCount}}</strong>
              </li>
            {{/each}}
          </ul>
        </div>
      </section>

      <section class="table" data-animate style="--delay: 0.5s;">
        <table>
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Txid</th>
              <th>Type</th>
              <th>Asset</th>
              <th>Amount</th>
              <th>From</th>
              <th>To</th>
              <th>Method</th>
            </tr>
          </thead>
          <tbody>
            {{#each transactions}}
              <tr>
                <td>{{this.timestampLabel}}</td>
                <td class="mono">{{this.shortTxid}}</td>
                <td>{{this.type}}</td>
                <td class="mono">{{this.asset}}</td>
                <td>{{this.amountLabel}}</td>
                <td class="mono">{{this.from}}</td>
                <td class="mono">{{this.to}}</td>
                <td class="mono">{{this.method}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </section>
    </main>
    <script>
      (function() { const toggle = document.getElementById('theme-toggle'); if
      (toggle) { toggle.addEventListener('click', function() { const isDark =
      document.documentElement.getAttribute('data-theme') === 'dark'; const
      newTheme = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('neo-theme', newTheme); }); } })();
    </script>
  </body>
</html>