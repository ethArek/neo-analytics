<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Neo Analytics - {{date}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/css/styles.css" />
  {{> matomo}}
</head>
<body>
  <main class="container">
    {{> navbar}}

    <header class="hero" data-animate style="--delay: 0s;">
      <div>
        <h1>Neo Analytics</h1>
        <p class="subtitle">Day details: {{date}}</p>
        <p class="hero-meta">Classified transactions and breakdowns for the selected day.</p>
      </div>
      <div class="hero-actions">
        <a href="/dashboard" class="button">Back to dashboard</a>
      </div>
    </header>

    {{#if stat}}
    <section class="summary-grid">
      <div class="card accent" data-animate style="--delay: 0.05s;">
        <span>Total transactions</span>
        <strong>{{stat.totalTxCount}}</strong>
        <small>All scanned blocks</small>
      </div>
      <div class="card" data-animate style="--delay: 0.1s;">
        <span>Total transactions excluding Gas Claims</span>
        <strong>{{stat.realUsageTotal}}</strong>
        <small>Swaps + transfers</small>
      </div>
      <div class="card" data-animate style="--delay: 0.15s;">
        <span>Active addresses</span>
        <strong>{{stat.uniqueAddresses}}</strong>
        <small>Unique senders + receivers</small>
      </div>
      <div class="card" data-animate style="--delay: 0.2s;">
        <span>NEO volume</span>
        <strong>{{stat.neoVolume}}</strong>
      </div>
      <div class="card" data-animate style="--delay: 0.25s;">
        <span>GAS volume</span>
        <strong>{{stat.gasVolume}}</strong>
      </div>
      <div class="card" data-animate style="--delay: 0.3s;">
        <span>Others</span>
        <strong>{{stat.othersCount}}</strong>
        <small>Ignored or uncategorized</small>
      </div>
      <div class="card" data-animate style="--delay: 0.35s;">
        <span>Blocks scanned</span>
        <strong>{{stat.blockCount}}</strong>
        <small>Daily total</small>
      </div>
    </section>
    {{else}}
    <p>No stats found for this day.</p>
    {{/if}}

    <section class="list-grid">
      <div class="list-card" data-animate style="--delay: 0.35s;">
        <h3>Asset breakdown</h3>
        <ul>
          {{#each assetStats}}
          <li>
            <div>
              <div class="mono">{{this.assetLabel}}</div>
              <small>{{this.transferCount}} transfers</small>
            </div>
            <strong>{{this.volumeLabel}}</strong>
          </li>
          {{/each}}
        </ul>
      </div>
      <div class="list-card" data-animate style="--delay: 0.4s;">
        <h3>Top methods</h3>
        <ul>
          {{#each methodStats}}
          <li>
            <div class="mono">{{this.method}}</div>
            <strong>{{this.txCount}}</strong>
          </li>
          {{/each}}
        </ul>
      </div>
      <div class="list-card" data-animate style="--delay: 0.45s;">
        <h3>Top contracts</h3>
        <ul>
          {{#each contractStats}}
          <li>
            <div class="mono">{{this.contract}}</div>
            <strong>{{this.txCount}}</strong>
          </li>
          {{/each}}
        </ul>
      </div>
    </section>

    <section class="table" data-animate style="--delay: 0.5s;">
      <table>
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>Txid</th>
            <th>Type</th>
            <th>Asset</th>
            <th>Amount</th>
            <th>From</th>
            <th>To</th>
            <th>Method</th>
          </tr>
        </thead>
        <tbody>
          {{#each transactions}}
          <tr>
            <td>{{this.timestampLabel}}</td>
            <td class="mono">{{this.shortTxid}}</td>
            <td>{{this.type}}</td>
            <td class="mono">{{this.assetLabel}}</td>
            <td>{{this.amountLabel}}</td>
            <td class="mono">{{this.from}}</td>
            <td class="mono">{{this.to}}</td>
            <td class="mono">{{this.method}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </section>
  </main>
</body>
</html>
