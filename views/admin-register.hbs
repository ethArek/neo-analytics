<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin registration · Neo Analytics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main class="container">
      <header class="hero" data-animate style="--delay: 0s;">
        <div>
          <h1>Create admin</h1>
          <p class="subtitle">Register the first administrator account.</p>
        </div>
        <div class="hero-actions">
          <a class="button secondary" href="/">Back to dashboard</a>
        </div>
      </header>

      <section class="summary-section" data-animate style="--delay: 0.1s;">
        <div class="summary-header">
          <h2>Registration</h2>
        </div>
        {{#if error}}
          <p class="form-error">{{error}}</p>
        {{/if}}
        {{#if registrationDisabled}}
          <p class="form-note">Registration is disabled because an admin already exists.</p>
          <a class="button secondary" href="/admin/login">Go to login</a>
        {{else}}
          <form class="form-grid" method="post" action="/admin/register">
            <label>
              Email
              <input type="email" name="email" value="{{email}}" required />
            </label>
            <label>
              Password
              <input type="password" name="password" required />
            </label>
            <div class="form-actions">
              <button class="button" type="submit">Create admin</button>
              <a class="button secondary" href="/admin/login">Already registered?</a>
            </div>
          </form>
        {{/if}}
      </section>
    </main>
  </body>
</html>
