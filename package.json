{
  "name": "neo-analytics",
  "version": "1.0.0",
  "description": "Neo N3 analytics dashboard and API for tracking daily activity.",
  "license": "MIT",
  "homepage": "https://github.com/ethArek/neo-analytics",
  "repository": {
    "type": "git",
    "url": "https://github.com/ethArek/neo-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/ethArek/neo-analytics/issues"
  },
  "keywords": [
    "neo",
    "neo-n3",
    "blockchain",
    "analytics",
    "dashboard",
    "nestjs",
    "postgresql"
  ],
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build:client": "vite build --config frontend/vite.config.ts",
    "build": "npm run build:client && nest build && node scripts/copy-assets.js",
    "dev:client": "vite --config frontend/vite.config.ts",
    "lint": "biome lint . --diagnostic-level=error",
    "lint:ci": "biome lint . --diagnostic-level=error --reporter=summary --max-diagnostics=10",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "format:check:ci": "biome format . --reporter=summary --max-diagnostics=10",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "export:dora-csv": "node scripts/export-dora-transactions-csv.js"
  },
  "dependencies": {
    "@cityofzion/dora-ts": "^0.6.2",
    "@cityofzion/neon-js": "^5.8.1",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "chart.js": "^4.4.1",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@nestjs/cli": "^11.0.16",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prisma": "^7.6.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
