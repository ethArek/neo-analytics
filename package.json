{
  "name": "neo-analytics",
  "version": "1.0.0",
  "description": "Neo N3 analytics dashboard and API for tracking daily activity.",
  "license": "MIT",
  "homepage": "https://github.com/ethArek/neo-analytics",
  "repository": {
    "type": "git",
    "url": "https://github.com/ethArek/neo-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/ethArek/neo-analytics/issues"
  },
  "keywords": [
    "neo",
    "neo-n3",
    "blockchain",
    "analytics",
    "dashboard",
    "nestjs",
    "postgresql"
  ],
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build:client": "vite build --config frontend/vite.config.ts",
    "build": "npm run build:client && nest build && node scripts/copy-assets.js",
    "dev:client": "vite --config frontend/vite.config.ts",
    "lint": "biome lint . --diagnostic-level=error",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@cityofzion/neon-js": "^5.7.0",
    "@nestjs/common": "^10.3.2",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.2",
    "@nestjs/platform-express": "^10.3.2",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "7.2.0",
    "chart.js": "^4.4.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@nestjs/cli": "^10.4.2",
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.29",
    "@types/pg": "8.11.11",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prisma": "7.2.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
